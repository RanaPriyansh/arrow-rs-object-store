+    #[cfg(feature = "multithread-mm")]
+    #[test]
+    fn dispatch_controls() {
+        use rayon::ThreadPoolBuilder;
+
+        let ambient = ThreadPoolBuilder::new()
+            .num_threads(2)
+            .thread_name(|index| format!("mmm-control-{index}"))
+            .build()
+            .unwrap();
+        let supplied = ThreadPoolBuilder::new()
+            .num_threads(2)
+            .thread_name(|index| format!("mmm-supplied-{index}"))
+            .build()
+            .unwrap();
+        let serial = ThreadPoolBuilder::new().num_threads(1).build().unwrap();
+        let run = |pool: Option<&rayon::ThreadPool>,
+                   m,
+                   n,
+                   callback: &(
+                        dyn Fn(usize, usize, usize, usize, usize) -> TractResult<()> + Sync
+                    )| unsafe {
+            chunked_dispatch_rayon(pool, m, n, 1, 1, 1, 1, callback)
+        };
+
+        let observations = Arc::new(Mutex::new(Vec::<DispatchObservation>::new()));
+        let captured = observations.clone();
+        ambient
+            .install(|| {
+                run(Some(&supplied), 16, 16, &|a, b, c, d, e| {
+                    let current = thread::current();
+                    assert!(current.name().unwrap_or_default().starts_with("mmm-supplied-"));
+                    captured.lock().unwrap().push((a, b, c, d, e, thread::current().id()));
+                    Ok(())
+                })
+            })
+            .unwrap();
+        let observations = observations.lock().unwrap().clone();
+        let mut tiles = HashSet::new();
+        for (a, b, c, d, _, _) in observations {
+            for ia in a..b {
+                for ib in c..d {
+                    assert!(tiles.insert((ia, ib)));
+                }
+            }
+        }
+        assert_eq!(tiles.len(), 16 * 16);
+
+        let observations = Arc::new(Mutex::new(Vec::<DispatchObservation>::new()));
+        let captured = observations.clone();
+        ambient
+            .install(|| {
+                run(None, 16, 16, &|a, b, c, d, e| {
+                    let current = thread::current();
+                    assert!(current.name().unwrap_or_default().starts_with("mmm-control-"));
+                    assert_eq!(e, 2);
+                    captured.lock().unwrap().push((a, b, c, d, e, current.id()));
+                    Ok(())
+                })
+            })
+            .unwrap();
+        let observations = observations.lock().unwrap().clone();
+        let mut tiles = HashSet::new();
+        for (a, b, c, d, _, _) in observations {
+            for ia in a..b {
+                for ib in c..d {
+                    assert!(tiles.insert((ia, ib)));
+                }
+            }
+        }
+        assert_eq!(tiles.len(), 16 * 16);
+
+        let calls = Arc::new(Mutex::new(0));
+        let captured = calls.clone();
+        run(Some(&serial), 0, 16, &|_, _, _, _, _| {
+            *captured.lock().unwrap() += 1;
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(*calls.lock().unwrap(), 0);
+
+        let calls = Arc::new(Mutex::new(0));
+        let captured = calls.clone();
+        run(Some(&serial), 16, 0, &|_, _, _, _, _| {
+            *captured.lock().unwrap() += 1;
+            Ok(())
+        })
+        .unwrap();
