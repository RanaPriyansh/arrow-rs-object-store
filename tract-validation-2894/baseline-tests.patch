+    #[cfg(feature = "multithread-mm")]
+    #[test]
+    fn dispatch_controls_and_one_thread_pool_regression() {
+        use rayon::ThreadPoolBuilder;
+
+        let ambient = ThreadPoolBuilder::new()
+            .num_threads(2)
+            .thread_name(|index| format!("mmm-ambient-{index}"))
+            .build()
+            .unwrap();
+        let serial = ThreadPoolBuilder::new()
+            .num_threads(1)
+            .thread_name(|index| format!("mmm-serial-{index}"))
+            .build()
+            .unwrap();
+        let observations = Arc::new(Mutex::new(Vec::<DispatchObservation>::new()));
+        let captured = observations.clone();
+        let (caller, result) = ambient.install(|| {
+            let caller = thread::current().id();
+            let result = unsafe {
+                chunked_dispatch_rayon(
+                    Some(&serial),
+                    16,
+                    16,
+                    1,
+                    1,
+                    1,
+                    1,
+                    |ia_start, ia_end, ib_start, ib_end, concurrency| {
+                        captured.lock().unwrap().push((
+                            ia_start,
+                            ia_end,
+                            ib_start,
+                            ib_end,
+                            concurrency,
+                            thread::current().id(),
+                        ));
+                        Ok(())
+                    },
+                )
+            };
+            (caller, result)
+        });
+        result.unwrap();
+        let observations = observations.lock().unwrap().clone();
+        assert_eq!(observations.len(), 1);
+        assert_eq!(observations[0].0..observations[0].1, 0..16);
+        assert_eq!(observations[0].2..observations[0].3, 0..16);
+        assert_eq!(observations[0].4, 1);
+        assert_eq!(observations[0].5, caller);
+
+        let observations = Arc::new(Mutex::new(Vec::<DispatchObservation>::new()));
+        let captured = observations.clone();
+        let (caller, result) = ambient.install(|| {
+            let caller = thread::current().id();
+            let result = unsafe {
+                chunked_dispatch_rayon(
+                    Some(&serial),
+                    16,
+                    16,
+                    1,
+                    1,
+                    1,
+                    1,
+                    |ia_start, ia_end, ib_start, ib_end, concurrency| {
+                        captured.lock().unwrap().push((
+                            ia_start,
+                            ia_end,
+                            ib_start,
+                            ib_end,
+                            concurrency,
+                            thread::current().id(),
+                        ));
+                        Err(tract_data::internal::anyhow!("dispatch regression error"))
+                    },
+                )
+            };
+            (caller, result)
+        });
+        assert_eq!(result.unwrap_err().to_string(), "dispatch regression error");
+        assert_eq!(*observations.lock().unwrap(), vec![(0, 16, 0, 16, 1, caller)]);
+    }
